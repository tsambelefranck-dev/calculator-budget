# ─── Base de données ───────────────────────────────────────────────
DATABASE_URL=postgres://nexafi:nexafi@localhost:5432/nexafi
# Base dédiée aux tests d'intégration (vidée à chaque exécution)
DATABASE_URL_TEST=postgres://nexafi:nexafi@localhost:5432/nexafi_test

# ─── Application ───────────────────────────────────────────────────
# URL publique (liens des e-mails, contrôle d'origine des API)
APP_URL=http://localhost:3000
# Secret pour les tâches planifiées (Authorization: Bearer ...) — `openssl rand -hex 32`
CRON_SECRET=change-me
# Inscriptions autorisées par adresse IP et par heure (anti-abus)
SIGNUP_RATE_LIMIT_PER_HOUR=5
DEMO_RATE_LIMIT_PER_HOUR=5

# ─── Intelligence artificielle ─────────────────────────────────────
# Fournisseur : "anthropic" ou "disabled". Sans clé, l'assistant affiche clairement
# qu'il fonctionne en mode « analyse automatique » (sans IA).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modèle Claude (défaut : claude-opus-5-5). Voir docs/CONCEPTION.md §8 pour l'arbitrage coût/qualité.
AI_MODEL=claude-opus-5-5
# Effort de raisonnement : low | medium | high
AI_EFFORT=medium
# Quotas mensuels de messages
FREE_AI_MESSAGES_PER_MONTH=10
PREMIUM_AI_MESSAGES_PER_MONTH=100

# ─── E-mails (optionnel) ───────────────────────────────────────────
# Sans clé, les e-mails (réinitialisation de mot de passe) sont écrits dans les logs serveur
# en développement uniquement.
RESEND_API_KEY=
EMAIL_FROM="NexaFi <no-reply@example.com>"
